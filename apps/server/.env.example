# ローカルの SQLite ファイル。`turso dev` を使う場合は http://127.0.0.1:8080 を指定する
DATABASE_URL=file:local.db

# 32文字以上のランダム文字列（例: `openssl rand -base64 32`）
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters

# API サーバー自身の URL
BETTER_AUTH_URL=http://localhost:3000

# ブラウザ（Expo Web）からのアクセスを許可するオリジン
CORS_ORIGIN=http://localhost:8081

# Cloudflare R2（写真・動画のアップロード先）。未設定の場合、
# アップロード機能だけが無効になり、サーバー自体は起動する。
# ダッシュボードの R2 > Manage API tokens で作成した
# Object Read & Write のアクセスキーを使う。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=doo-media
# バケットの公開 URL（r2.dev のパブリック開発 URL かカスタムドメイン）
R2_PUBLIC_BASE_URL=
